# Local development database configuration
# This file is used by scripts/setup-local-db.sh to set up a local PostgreSQL database
# It should NEVER point to a production or shared database

DATABASE_URL=postgresql://postgres:postgres@localhost:5433/ds_app_local

DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5433
DB_NAME=ds_app_local

NODE_ENV=development
PORT=3000

APP_ORIGIN=http://localhost:3000
DEV_USER_PASSWORD=devpassword
JWT_SECRET=your_jwt_secret_key_here

DEV_USERNAME=email.com
VITE_DEV_USERNAME=email.com

VITE_ENABLE_DEV_LOGIN=true